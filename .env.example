# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Flask
SECRET_KEY=your-very-long-random-secret-key-here
JWT_SECRET_KEY=your-very-long-random-jwt-key-here
FLASK_ENV=production

# PostgreSQL (from your hosting provider)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (SMTP)
MAIL_SERVER=laundry.sparkvista.biz
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=info@laundry.sparkvista.biz
MAIL_PASSWORD=tDwv6JU+ZH$c{*P4

# Admin setup — remove after creating your first admin account
# Generate a strong random string: openssl rand -hex 32
ADMIN_SETUP_TOKEN=your-strong-random-token-here
